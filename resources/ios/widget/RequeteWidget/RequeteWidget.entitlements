<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Groupe d’apps partagé par l’app et son widget : l’app y range la série (RequeteWidgetPlugin), le widget l’y lit. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.fr.requete.app</string>
	</array>
</dict>
</plist>

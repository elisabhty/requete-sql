<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Groupe d’apps partagé par l’app et son widget : l’app y range la série (RequeteWidgetPlugin), le widget l’y lit. -->
<!-- aps-environment (7 novembre, la salle dans l’île) : les push d’Apple, pour que le serveur mette à jour la Live Activity de la
     salle l’app fermée. « development » ici ; Xcode le passe en « production » pour TestFlight et l’App Store (signature
     automatique, -allowProvisioningUpdates : il ajoute aussi la capacité Push Notifications à l’identifiant fr.requete.app). -->
<!-- com.apple.developer.applesignin (12 novembre, la connexion) : « Se connecter avec Apple » (connexion.js). Xcode ajoute la capacité
     Sign In with Apple à l’identifiant fr.requete.app en signant (-allowProvisioningUpdates), comme pour les push. -->
<!-- com.apple.developer.associated-domains (13 novembre, 19 h 31, les liens universels) : une invitation à un défi
     (https://requeteapp.com/?partie=CODE) touchée dans Messages ou WhatsApp ouvre l’app dans la salle, plus le site. Le site sert
     .well-known/apple-app-site-association (l’équipe RN77C85JG4, fr.requete.app) ; Xcode ajoute la capacité Associated Domains à
     l’identifiant en signant (-allowProvisioningUpdates), comme pour les push. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:requeteapp.com</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.fr.requete.app</string>
	</array>
</dict>
</plist>

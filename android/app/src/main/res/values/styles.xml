<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Toujours en clair : l’appli a ses propres couleurs ; le mode sombre du téléphone ne repeint pas la page. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/requete_fond</item>
        <item name="android:forceDarkAllowed">false</item>
        <!-- 25 novembre (le parcours sur les émulateurs de GitHub) : l’heure, la batterie et le réseau en sombre, comme sur iPhone.
             À la fin de l’écran de lancement, Android reprend ces deux réglages du thème : sans eux, les icônes passaient en blanc
             sur le fond lavande de l’appli et ne se voyaient plus. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>


    <!-- L’écran de lancement : le fond lavande de l’appli, l’icône au centre (Android 12 et plus). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/requete_fond</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
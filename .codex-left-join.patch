   anatomie:[{tok:"SELECT clients.nom, commandes.quantite",txt:"Les colonnes à afficher."},{tok:"FROM clients",txt:"La table de gauche : tous ses enregistrements seront conservés."},{tok:"LEFT JOIN commandes",txt:"La table de droite : on ajoute les correspondances si elles existent."},{tok:"ON clients.id = commandes.client_id",txt:"La condition de correspondance. Si aucune correspondance, les colonnes de droite sont NULL."}],

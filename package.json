{
  "name": "requete-sql",
  "version": "1.0.0",
  "private": true,
  "description": "Requête — Apprends le SQL (web + app iOS via Capacitor)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:www": "node scripts/build-www.mjs",
    "ios:add": "npm run build:www && npx cap add ios",
    "ios:assets": "npx capacitor-assets generate --ios --assetPath resources",
    "ios": "npm run build:www && npx cap sync ios && npx cap open ios",
    "db:photo": "node scripts/db-snapshot.mjs snapshot",
    "db:liste": "node scripts/db-snapshot.mjs list",
    "db:diff": "node scripts/db-snapshot.mjs diff",
    "db:restaurer": "node scripts/db-snapshot.mjs restore"
  },
  "dependencies": {
    "@capacitor/core": "latest",
    "@capacitor/haptics": "latest",
    "@capacitor/ios": "latest",
    "@capacitor/keyboard": "latest",
    "@capacitor/local-notifications": "latest",
    "@capacitor/splash-screen": "latest",
    "@capacitor/status-bar": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "latest",
    "@capacitor/cli": "latest"
  }
}

{
  "appId": "fr.requete.app",
  "appName": "Requête",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F4F2FC",
    "preferredContentMode": "mobile",
    "scrollEnabled": false,
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 4000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#F4F2FC",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "native",
      "style": "LIGHT",
      "resizeOnFullScreen": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": "",
      "appReadyTimeout": 20000,
      "responseTimeout": 60
    },
    "SocialLogin": {
      "providers": {
        "apple": true,
        "google": true,
        "facebook": false,
        "twitter": false
      },
      "logLevel": 1
    }
  }
}
